# Server
PORT_API=3007
NODE_ENV=development

# MongoDB
# Development: local instance
MONGO_DEV=mongodb://localhost:27017/fbcgroup
# Production: Atlas cluster (required when NODE_ENV=production)
MONGO_PROD=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — minimum 32 characters, use a random secret generator
SECRET_TOKEN=change-me-to-a-random-32-char-minimum-secret

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
